library(readr)
library(tidyr)
library(magrittr)
library(dplyr)
library(Matrix)
library(foreach)
library(doParallel)
library(ggplot2)
library(cowplot)
library(ggpubr)
library(ggh4x)
library(latex2exp)
library(scales)
library(Hmisc)
library(igraph)
setwd("~/Documents/GWAS/project_4/real_data/glgc")
dbs = c("UKBB", "GLGC")
phenos = c("HDL", "LDL", "TG", "TC")
pids = c("EUR", "AFR", "EAS")
methods = c("MACHINE + g-LDSC" = "MACHINE-gLDSC",
"MACHINE" = "MACHINE",
"MESuSiE" = "MESuSiE",
"h2-D2 + g-LDSC" = "h2D2-gLDSC",
"h2-D2" = "h2D2",
"SuSiE" = "SuSiE",
"RSparsePro" = "RSparsePro",
"CARMA" = "CARMA")
data = readRDS("CS_overlap_num.RData")
View(data)
16691 / 750
17964 / 747
15933 / 685
16297 / 651
28398 / 1167
25572 / 1072
data = data[,-c(12,13)]
write_delim(data, "CS_overlap_num.txt", delim = '\t')
saveRDS(data, "CS_overlap_num.RData")
data = data[,-11]
write_delim(data, "CS_overlap_num.txt", delim = '\t')
saveRDS(data, "CS_overlap_num.RData")
methods
dbs
Dir = methods[1]
db = "GLGC"
results = read.delim(sprintf("results/%s/%s/%s/results.txt", Dir, pheno,
db))
pheno = "HDL"
results = read.delim(sprintf("results/%s/%s/%s/results.txt", Dir, pheno,
db))
for(Dir in methods[1:3])
{
for(db in dbs[2])
{
for(pheno in phenos)
{
results = read.delim(sprintf("results/%s/%s/%s/results.txt", Dir, pheno,
db))
results$db = db
write_delim(results, sprintf("results/%s/%s/%s/results.txt", Dir, pheno,
db), delim = '\t')
CS_info_all = read.delim(sprintf("results/%s/%s/%s/CS_info.txt", Dir, pheno,
db))
CS_info_all$CS.tags[is.na(CS_info_all$CS.tags)] = ""
CS_info_all$db = db
write_delim(CS_info_all, sprintf("results/%s/%s/%s/CS_info.txt", Dir, pheno,
db), delim = '\t')
CS_corr_all = read.delim(sprintf("results/%s/%s/%s/CS_corr.txt", Dir, pheno,
db))
CS_info_all$db = db
write_delim(CS_corr_all, sprintf("results/%s/%s/%s/CS_corr.txt", Dir, pheno,
db), delim = '\t')
}
}
}
for(Dir in methods[4:8])
{
for(db in dbs[2])
{
for(pheno in phenos)
{
for(pid in pids)
{
results = read.delim(sprintf("results/%s/%s/%s/%s/results.txt", Dir, pheno,
db, pid))
results$db = db
write_delim(results, sprintf("results/%s/%s/%s/%s/results.txt", Dir, pheno,
db, pid), delim = '\t')
CS_info_all = read.delim(sprintf("results/%s/%s/%s/%s/CS_info.txt", Dir,
pheno, db, pid))
CS_info_all$CS.tags[is.na(CS_info_all$CS.tags)] = ""
CS_info_all$db = db
write_delim(CS_info_all, sprintf("results/%s/%s/%s/%s/CS_info.txt", Dir,
pheno, db, pid), delim = '\t')
if(file.exists(sprintf("results/%s/%s/%s/%s/CS_corr.txt", Dir,
pheno, db, pid)))
{
CS_corr_all = read.delim(sprintf("results/%s/%s/%s/%s/CS_corr.txt", Dir,
pheno, db, pid))
CS_info_all$db = db
write_delim(CS_corr_all, sprintf("results/%s/%s/%s/%s/CS_corr.txt", Dir,
pheno, db, pid), delim = '\t')
}
}
}
}
}
